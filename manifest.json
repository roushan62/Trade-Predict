{
  "manifest_version": 3,
  "name": "AI Chart Predictor",
  "version": "1.0.0",
  "description": "Screenshot a chart, ask a vision AI for technical analysis, and draw support/resistance, zones and predicted ghost candles on it.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Chart Predictor \u2014 click or press Alt+Shift+A",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Show or hide the AI Chart Predictor panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/constants.js",
        "utils/coords.js",
        "utils/settings.js",
        "providers/index.js",
        "providers/openai.js",
        "providers/openrouter.js",
        "providers/gemini.js",
        "providers/anthropic.js",
        "providers/deepseek.js",
        "providers/mistral.js",
        "providers/groq.js",
        "providers/xai.js",
        "providers/custom.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
